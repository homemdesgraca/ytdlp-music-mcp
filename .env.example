LIBRARYPATH = "" #ABSOLUTE path for your music library
FIREFOX_PROFILE_PATH =  #OPTIONAL/Needed for explicit songs; Profile name of Firefox Profile that will be used (check README for more info)
USE_BEETS = True #VERY RECOMMENDED; Input 'False' if you want to disable the usage of beets for your library management; Note: This project has been developed with beets usage in mind, not using it will be janky.